#!/bin/bash
#SBATCH --time=720
#SBATCH --job-name=maloney
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --nodes=1
#SBATCH --partition=gpu
#SBATCH --mem=24G
#SBATCH --gres=gpu:1
#SBATCH --account=cai_nlp
#SBATCH --mail-user=saaf@zhaw.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --output=logs/slurm/%j_%N.out
#SBATCH --error=logs/slurm/%j_%N.err
#SBATCH --open-mode=append

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
source scripts/slurm_setup.sh

run uv run --no-sync baseline -m method=b1,b2,m1,m2 geo.mapping.mode=centroid,uniform,gaussian