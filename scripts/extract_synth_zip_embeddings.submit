#!/bin/bash
#SBATCH --time=240
#SBATCH --job-name=whisper_embeddings_synth_zip
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --nodes=1
#SBATCH --partition=gpu_top
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --account=cai_nlp
#SBATCH --mail-user=saaf@zhaw.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --output=logs/slurm/%j_%N.out
#SBATCH --error=logs/slurm/%j_%N.err
#SBATCH --open-mode=append

# Whisper embeddings of the zip-filled synthetic dataset (uv run anonymize-zip) for
# playground/09_geo_probe.ipynb: only the clips of its train_all/valid/test.tsv (~49k; its audio_16k.h5
# also links all clips of the source release, which are not needed). Writes
# <data_dir>/embeddings/<model>.h5, where the notebook looks for it. Extra arguments go to
# scripts/extract_whisper_embeddings.py; a job that hits the time limit resumes when submitted again.
#
#   sbatch scripts/extract_synth_zip_embeddings.submit                                  # whisper-large-v3
#   sbatch scripts/extract_synth_zip_embeddings.submit --model openai/whisper-tiny
#   DATA_DIR=data/other DRY_RUN=1 bash scripts/extract_synth_zip_embeddings.submit

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"

DATA_DIR="${DATA_DIR:-data/stt4sg-350_synth_zip}"
TSVS=("${DATA_DIR}"/train_all.tsv "${DATA_DIR}"/valid.tsv "${DATA_DIR}"/test.tsv)
for file in "${DATA_DIR}/audio_16k.h5" "${TSVS[@]}"; do
    if [ ! -f "${file}" ]; then
        echo "ERROR: ${file} not found on $(hostname) (cwd $(pwd))" >&2
        exit 1
    fi
done

source scripts/slurm_setup.sh

# audio_16k.h5 links to the source release's audio; a missing link would read as silence.
run uv run --no-sync python -c "import sys; from maloney.data.meta import read_h5_index; read_h5_index(sys.argv[1])" \
    "${DATA_DIR}/audio_16k.h5"
run uv run --no-sync python scripts/extract_whisper_embeddings.py "${DATA_DIR}" --tsv "${TSVS[@]}" "$@"
