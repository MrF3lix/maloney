#!/bin/bash
#SBATCH --time=720
#SBATCH --job-name=whisper_embeddings
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --nodes=1
#SBATCH --partition=gpu_top
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --account=cai_nlp
#SBATCH --mail-user=saaf@zhaw.ch
#SBATCH --mail-type=END,FAIL
#SBATCH --output=logs/slurm/%j_%N.out
#SBATCH --error=logs/slurm/%j_%N.err
#SBATCH --open-mode=append

# Precompute Whisper encoder embeddings of all clips into <data_dir>/embeddings/<model>.h5.
# Arguments go to scripts/extract_whisper_embeddings.py. If the job hits the time limit, submit it
# again with the same arguments: it resumes where it stopped.
#
#   sbatch scripts/extract_whisper_embeddings.submit data/stt4sg-350_v2-1
#   sbatch scripts/extract_whisper_embeddings.submit data/stt4sg-350_v2-1 --model openai/whisper-medium
#   DRY_RUN=1 bash scripts/extract_whisper_embeddings.submit data/stt4sg-350_v2-1

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
source scripts/slurm_setup.sh

# Model weights are cached once on the persistent scratch disk instead of the home quota.
export HF_HOME="${HF_HOME:-/raid/persistent_scratch/saaf/huggingface}"

run uv run --no-sync python scripts/extract_whisper_embeddings.py "$@"
